Algoritmo Act3_Lecc20_Inc2
	Definir n Como Real
	Escribir "Escriba la calificacion del estudiante"
	Leer n
	Si ( n >= 0 y n <70) Entonces
		Escribir "El estudiante ha reprobado"
		
	FinSi
	Si ( n >= 70 y n <= 100) Entonces
		Escribir "El estudiante ha aprobado"
	FinSi
	Si ( n>100) Entonces
		Escribir "Esa nota no existe"
	FinSi
FinAlgoritmo
