//Problema:Si un numero ingresado por el usuario es positivo o negativo
Algoritmo EjemploSiEntonces
	Definir num Como Entero
	Escribir ("Dame un numero entero")
	Leer num
	si (num>=0)Entonces
		Escribir "Es un numero positivo"
	SiNo
		Escribir "Es un numero negativo"
	FinSi
	
FinAlgoritmo
