Algoritmo Act2_Lecc7_Inc2
	Definir N Como Real
	Escribir "Digame su  nota"
	Leer N
	Si (N >= 0 y N < 60) Entonces
		Escribir "Deficiente"
	FinSi
	Si (N >= 60 y N < 70) Entonces
		Escribir "Regular"
	FinSi
	Si (N >= 70 y N < 80) Entonces
		Escribir "Bien"
	FinSi
	Si (N >= 80 y N < 90) Entonces
		Escribir "Muy bien"
	FinSi
	Si (N >= 90 y N < 100) Entonces
		Escribir "Excelente"
	FinSi
FinAlgoritmo
